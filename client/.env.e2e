# EVOX E2E Test Credentials — PS-main harness
# Never commit this file to git.
#
# Naming convention for user credentials:
#   E2E_USER_<ROLE>_<GEO> — matches the menus/<Role>-<Geo>/ folder index exactly.
#   Add one entry per menus/ folder. Both .env.e2e (Playwright) and server/.env
#   (PHPUnit) must carry the same keys so all test layers use the same user.

PLAYWRIGHT_BASE_URL=https://evoxtest.eastvantage.com

# API key — Playwright only.
# PHPUnit generates a fresh key per test via DB::table('api_keys')->insert() and DatabaseTransactions
# rolls it back after. PHPUnit does NOT read this value.
E2E_API_KEY=RlYVynDl9ALmOtfCotsLS9iSr93bMzgpIWfoxLktznLfTUL3NfaNO5HittoAfA9Z

