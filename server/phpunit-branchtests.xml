<?xml version="1.0" encoding="UTF-8"?>
<!--
  BranchTests coverage config — Windows paths for evox-app-e2e on this machine.
  Runs only tests/Feature/BranchTests (81 PHP files, 16 modules).
  Unit/ and legacy Feature/ suites removed — only BranchTests remain in server/tests.

  Run from server/ directory:
    php -d memory_limit=4G vendor/bin/phpunit (dash dash)configuration phpunit-branchtests.xml
-->
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="BranchTests">
            <directory suffix="Test.php">./tests/Feature/BranchTests</directory>
        </testsuite>
    </testsuites>

    <filter>
        <whitelist processUncoveredFilesFromWhitelist="false">
            <directory suffix=".php">./app</directory>
            <exclude>
                <!-- Migrations are schema history, never run by this suite (the test DB
                     forbids them). 48 classes x 2 methods = 96 methods that no permitted
                     test can cover, worth ~5pp on methods and ~8pp on classes. Keep this
                     in EVERY phpunit config - patching only some is why the 7-Aug run
                     reported 62.93% instead of 68.01%. -->
                <directory suffix=".php">./app/Modules/*/Database/Migrations</directory>
            </exclude>
        </whitelist>
    </filter>

    <logging>
        <log type="coverage-html"
             target="C:\DFolder\Projects\EVOX\E2eTesting\Gary &amp; Glenn Report\evoxtest_final-report\backend"
             lowUpperBound="50"
             highLowerBound="90"/>
    </logging>

    <php>
        <ini name="memory_limit" value="4G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="MAIL_DRIVER" value="array"/>
    </php>

</phpunit>
