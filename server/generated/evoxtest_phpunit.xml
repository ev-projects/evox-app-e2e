<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="../tests/bootstrap.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="false"
         convertWarningsToExceptions="false"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">../tests/Unit</directory>
        </testsuite>

        <testsuite name="Feature">
            <directory suffix="Test.php">../tests/Feature</directory>

            <!-- Pre-existing trivial placeholder — markTestIncomplete, not a real test -->
            <exclude>../tests/Feature/FeatureRoot/ExampleTest.php</exclude>

            <!--
              2026-08-18 cleanup: the following exclusions were stale — those files no longer
              exist on the test/coverage-bug-fix-20260812 branch. PHPUnit ignores missing paths
              silently, but keeping them creates false confidence. Documented here so the history
              is clear if they are ever restored.

              Removed stale exclusions:
                - tests/Feature/Api/AdminSyncApiTest.php       (deleted from branch)
                - tests/Feature/Vishnu/AdminSyncApiTest.php    (deleted from branch)
                - tests/Feature/Api/CronApiTest.php            (deleted from branch)
                - tests/Feature/Vishnu/CronApiTest.php         (deleted from branch)
                - tests/Feature/SchedulerFrequencyTest.php     (deleted from branch — BUG-074)
                - tests/Feature/Api/BookingApiTest.php         (deleted — dead code)
                - tests/Feature/Vishnu/MeetingRoomApiTest.php  (deleted — dead code)
                - tests/Feature/Vishnu/RoomApiTest.php         (deleted — dead code)
                - tests/Feature/Vishnu/PoliciesCocRoomsApiTest.php (deleted — dead code)
                - tests/Feature/CoverageMax/PayrollWebBrokenTest.php (deleted — intentionally broken)
            -->

        </testsuite>
    </testsuites>

    <!-- Dead-code group exclusion: any test method/class tagged @group dead-code is skipped.
         No files currently carry this tag (verified 2026-08-18). The group filter stays as a
         safety net for any future tagging. -->
    <groups>
        <exclude>
            <group>dead-code</group>
        </exclude>
    </groups>

    <filter>
        <whitelist processUncoveredFilesFromWhitelist="false">
            <directory suffix=".php">../app</directory>
            <exclude>
                <!-- Spatie model: Eloquent alias unavailable outside Laravel boot context -->
                <file>../app/Models/Activity.php</file>
                <!--
                  Migrations are schema history, not application behaviour. The test database is
                  a live-server backup dump — migrations are forbidden outright. 48 classes × 2
                  methods = 96 methods that no permitted test can ever cover, depressing the
                  method figure by ~5 points and the class figure by ~8 for no diagnostic value.
                -->
                <directory suffix=".php">../app/Modules/*/Database/Migrations</directory>
            </exclude>
        </whitelist>
    </filter>

    <logging>
        <log type="coverage-text" target="php://stdout" showUncoveredFiles="false"/>
        <log type="coverage-clover" target="C:\DFolder\Projects\EVOX\E2eTesting\VishnuTestCases\EVOX-TEST-SUITE-FULL-2026-08-18\Coverage\evoxtest_coverage_clover_backend.xml"/>
        <log type="coverage-html"   target="C:\DFolder\Projects\EVOX\E2eTesting\VishnuTestCases\EVOX-TEST-SUITE-FULL-2026-08-18\Coverage\backend"/>
    </logging>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="PAYROLL_USER" value="testPayroll@eastvantage.com"/>
        <env name="CLIENT_USER_EMAIL" value="glenn.macasarte@eastvantage.com"/>
        <env name="CLIENT_USER_PASSWORD" value="{ev2010}"/>
        <ini name="error_reporting" value="31735"/>
        <ini name="memory_limit" value="6G"/>
    </php>
</phpunit>
