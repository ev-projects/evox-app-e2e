<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPLIT RUN — PART 2 of 2
  Covers: Feature/BranchTests + Feature/CoverageMax + Feature/Validation
  Outputs: coverage-php serialized object (part2.cov) — no HTML, no clover (generated by merge script)
  Run AFTER part1 completes. Then run evoxtest_merge_coverage.php to produce final HTML + clover.
-->
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="../tests/bootstrap.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="false"
         convertWarningsToExceptions="false"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Feature-Part2">
            <directory suffix="Test.php">../tests/Feature/BranchTests</directory>
            <directory suffix="Test.php">../tests/Feature/CoverageMax</directory>
            <directory suffix="Test.php">../tests/Feature/Validation</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>dead-code</group>
        </exclude>
    </groups>

    <filter>
        <whitelist processUncoveredFilesFromWhitelist="false">
            <directory suffix=".php">../app</directory>
            <exclude>
                <file>../app/Models/Activity.php</file>
            </exclude>
        </whitelist>
    </filter>

    <logging>
        <log type="coverage-text" target="php://stdout" showUncoveredFiles="false"/>
        <log type="coverage-php" target="C:\DFolder\Projects\EVOX\E2eTesting\PS-main\PS-main\.evox-test-backend\generated\evoxtest_coverage_part2.cov"/>
    </logging>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="MAIL_DRIVER" value="array"/>
        <ini name="error_reporting" value="31735"/>
        <ini name="memory_limit" value="4G"/>
    </php>
</phpunit>
