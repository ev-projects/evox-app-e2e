<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="../tests/bootstrap.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="false"
         convertWarningsToExceptions="false"
         processIsolation="false"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="Feature-Part2">
            <!-- All of tests/Feature except what Part 1 already ran -->
            <directory suffix="Test.php">../tests/Feature</directory>

            <!-- Exclude Part 1 directories (already covered) -->
            <exclude>../tests/Feature/Api</exclude>
            <exclude>../tests/Feature/BranchTests</exclude>
            <exclude>../tests/Feature/CoverageMax</exclude>
            <exclude>../tests/Feature/Console</exclude>

            <!-- Same excludes as evoxtest_phpunit.xml -->
            <exclude>../tests/Feature/FeatureRoot/ExampleTest.php</exclude>
            <exclude>../tests/Feature/Vishnu/AdminSyncApiTest.php</exclude>
            <exclude>../tests/Feature/Vishnu/CronApiTest.php</exclude>
            <exclude>../tests/Feature/SchedulerFrequencyTest.php</exclude>
            <exclude>../tests/Feature/Vishnu/MeetingRoomApiTest.php</exclude>
            <exclude>../tests/Feature/Vishnu/RoomApiTest.php</exclude>
            <exclude>../tests/Feature/Vishnu/PoliciesCocRoomsApiTest.php</exclude>
            <exclude>../tests/Feature/CoverageMax/PayrollWebBrokenTest.php</exclude>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>dead-code</group>
        </exclude>
    </groups>

    <filter>
        <whitelist processUncoveredFilesFromWhitelist="false">
            <directory suffix=".php">../app</directory>
            <exclude>
                <file>../app/Models/Activity.php</file>
                <directory suffix=".php">../app/Modules/*/Database/Migrations</directory>
                <file>../app/Http/Controllers/RoomController.php</file>
                <file>../app/Http/Controllers/LocationController.php</file>
