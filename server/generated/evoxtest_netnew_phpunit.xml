<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="../tests/bootstrap.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="false"
         convertWarningsToExceptions="false"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="NetNew">
            <directory suffix="Test.php">C:\DFolder\Projects\EVOX\E2eTesting\VishnuTestCases\EVOX-TEST-SUITE-NETNEW-2026-07-24\backend\branch-tests</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>dead-code</group>
        </exclude>
    </groups>

    <filter>
        <whitelist processUncoveredFilesFromWhitelist="false">
            <directory suffix=".php">../app</directory>
            <exclude>
                <!-- Migrations are schema history, never run by this suite (the test DB
                     forbids them). 48 classes x 2 methods = 96 methods that no permitted
                     test can cover, worth ~5pp on methods and ~8pp on classes. Keep this
                     in EVERY phpunit config - patching only some is why the 7-Aug run
                     reported 62.93% instead of 68.01%. -->
                <directory suffix=".php">../app/Modules/*/Database/Migrations</directory>
                <!-- Spatie model: Eloquent alias unavailable outside Laravel boot context -->
                <file>../app/Models/Activity.php</file>
            </exclude>
        </whitelist>
    </filter>

    <logging>
        <log type="coverage-text" target="php://stdout" showUncoveredFiles="false"/>
        <log type="coverage-clover" target="C:\DFolder\Projects\EVOX\E2eTesting\PS-main\PS-main\.evox-test-backend\generated\evoxtest_coverage_clover_netnew.xml"/>
        <log type="coverage-html" target="C:\DFolder\Projects\EVOX\E2eTesting\Gary &amp; Glenn Report\evoxtest_final-report\backend-netnew"/>
    </logging>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="PAYROLL_USER" value="testPayroll@eastvantage.com"/>
        <env name="CLIENT_USER_EMAIL" value="glenn.macasarte@eastvantage.com"/>
        <env name="CLIENT_USER_PASSWORD" value="{ev2010}"/>
        <ini name="error_reporting" value="31735"/>
        <ini name="memory_limit" value="4G"/>
    </php>
</phpunit>
